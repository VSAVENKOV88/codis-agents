#!/usr/bin/env node
'use strict';
// Refuses a push to a protected branch or of a protected tag (project config "protectedBranches",
// "protectedTagPattern"; a release tag may deploy to production). Without protectedBranches the default branch is
// protected: defaultBranch of the config, else the one the remote names (config.js pushBranches: git ls-remote
// --symref -- <url> HEAD, the URL git passes as the second argument) - never the local refs/remotes/origin/HEAD, which
// a wrapper can move. When neither answers (no key, the remote unreachable or naming no HEAD), every branch push is
// refused with the reason - closed, not open. The remote is asked only for a branch push. Only ALLOW_PROTECTED_PUSH=1, set on the owner's
// explicit word, lets it through - or, for a branch only, a standing push declared in the committed config of this
// repository (scripts/standing-push.js: HEAD only, no deletion, check green; tags never).
// Install once for all worktrees: git config core.hooksPath <plugin>/scripts/git-hooks
const path = require('path');
const { loadOrDefaults, pushBranches } = require(path.join(__dirname, '..', 'config.js'));
const standingPush = require(path.join(__dirname, '..', 'standing-push.js'));

if (process.env.ALLOW_PROTECTED_PUSH === '1') process.exit(0);
const cfg = loadOrDefaults(process.cwd(), process.env);
const tagRe = new RegExp(cfg.protectedTagPattern);
let input = '';
process.stdin.on('data', (d) => { input += d; });
process.stdin.on('end', () => {
  let bad = 0, st, pending = 0, pb;
  const url = process.argv[3] || process.argv[2] || '';
  for (const line of input.split('\n')) {
    const [, lsha, rref] = line.trim().split(/\s+/);
    if (!rref) continue;
    if (rref.startsWith('refs/heads/') && pb === undefined) pb = pushBranches(cfg, url, process.cwd());
    if (rref.startsWith('refs/heads/') && !pb.protectedBranches) {
      console.error(`pre-push: push to ${rref.slice(11)} is blocked: protected branches unknown - ${pb.why}`); bad = 1;
    } else if (rref.startsWith('refs/heads/') && pb.protectedBranches.includes(rref.slice(11))) {
      if (st === undefined) st = standingPush.standing(process.cwd());
      if (st && st.branches.includes(rref.slice(11)) && lsha === st.head) { pending++; continue; }
      console.error(`pre-push: push to ${rref.slice(11)} is blocked (ALLOW_PROTECTED_PUSH=1 only on the owner's word)`); bad = 1;
    } else if (rref.startsWith('refs/tags/') && tagRe.test(rref.slice(10))) {
      console.error(`pre-push: tag ${rref} is blocked - it may deploy to production (ALLOW_PROTECTED_PUSH=1 only on the owner's word)`); bad = 1;
    }
  }
  if (!bad && pending) {
    const why = standingPush.verify(st);
    if (why) { console.error('pre-push: ' + why); bad = 1; }
  }
  process.exit(bad);
});
