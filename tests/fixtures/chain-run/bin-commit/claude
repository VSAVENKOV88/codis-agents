#!/usr/bin/env node
'use strict';
// A wrapper over the fake claude CLI (tests/fixtures/chain-run/bin/claude) for tests/chain-run-reconcile-tester-cases.js:
// a call of the programmer role (--agent ...:programmer) first commits one file in $COMMIT_WT (a role that commits and
// is then cut off), then hands its argv and stdin to the fake CLI as a child, so the role is a process group with a
// descendant. Every other call goes to the fake CLI unchanged. It calls no model.
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const FAKE = path.join(__dirname, '..', 'bin', 'claude');
const argv = process.argv.slice(2);
const i = argv.indexOf('--agent');
const wt = process.env.COMMIT_WT;
if (i >= 0 && /:programmer$/.test(argv[i + 1] || '') && wt) {
  const f = `p-${process.pid}.txt`;
  fs.writeFileSync(path.join(wt, f), `${process.pid}\n`);
  const g = (...a) => spawnSync('git', ['-C', wt, '-c', 'user.name=t', '-c', 'user.email=t@t'].concat(a), { encoding: 'utf8' });
  g('add', '--', f);
  g('commit', '-q', '-m', `programmer ${process.pid}`);
}
let input = '';
if (argv[0] !== '--version') { try { input = fs.readFileSync(0, 'utf8'); } catch { /* no stdin */ } }
const p = spawnSync(process.execPath, [FAKE].concat(argv), { input, stdio: ['pipe', 'inherit', 'inherit'] });
process.exit(p.status === null ? 1 : p.status);
