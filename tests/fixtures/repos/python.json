    "pyproject.toml": "[project]\nname = \"fx-python\"\nversion = \"0.1.0\"\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\n",
    "tests/test_a.py": "def test_a():\n    assert True\n",
